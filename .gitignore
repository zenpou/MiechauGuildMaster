node_modules/
dist/
.npm-cache/
# 検証スクリプトが実行のたびに上書きする出力。再生成できない元画像だけ管理する
artifacts/*
!artifacts/source-art/
# 元画像のうち、差し替え前の旧版と初期案は手元だけに置く(ゲームに使わず、履歴を重くしない)
artifacts/source-art/revisions/
artifacts/source-art/tina-design-ideas/
artifacts/source-art/tina-design-ideas-v2/
# tsc を noEmit なしで実行したときの誤出力。ソースは .ts
src/**/*.js
tests/**/*.js
scripts/*.js
